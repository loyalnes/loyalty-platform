# Staging environment variables
# Copy to .env.staging and fill in actual values on the server

NODE_ENV=staging
PORT=3000
APP_PORT=3001

# Database
DB_USER=loyalty
DB_PASSWORD=CHANGE_ME_staging_password

# Docker image (set by CI, or override manually)
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE=your-org/loyalty-platform
IMAGE_TAG=staging

# WalletWallet Apple Wallet integration
WALLETWALLET_API_KEY=ww_live_replace_me
WALLETWALLET_COLOR_PRESET=dark
WALLETWALLET_LOGO_URL=https://placehold.co/512x512/png?text=Loyali
WALLETWALLET_THUMBNAIL_URL=https://placehold.co/240x240/png?text=Rewards
WALLETWALLET_STRIP_URL=https://placehold.co/1032x336/png/1f2937/ffffff?text=Loyali+Rewards
