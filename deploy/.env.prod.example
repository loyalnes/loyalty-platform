# Production environment variables
# Copy to .env.prod and fill in actual values on the server

NODE_ENV=production
PORT=3000
APP_PORT=3000

# Database
DB_USER=loyalty
DB_PASSWORD=CHANGE_ME_strong_production_password

# Docker image (set by CI, or override manually)
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE=your-org/loyalty-platform
IMAGE_TAG=latest

# CORS allowed origins (comma-separated). Omit to disallow cross-origin requests.
CORS_ORIGIN=https://yourdomain.com

# WalletWallet Apple Wallet integration
# Use GitHub secret WALLETWALLET_API_KEY in CI/CD for real deploys.
WALLETWALLET_API_KEY=ww_live_replace_me
WALLETWALLET_COLOR_PRESET=dark
WALLETWALLET_LOGO_URL=https://placehold.co/512x512/png?text=Loyali
WALLETWALLET_THUMBNAIL_URL=https://placehold.co/240x240/png?text=Rewards
WALLETWALLET_STRIP_URL=https://placehold.co/1032x336/png/1f2937/ffffff?text=Loyali+Rewards

# Google Wallet integration
# Requires Google Cloud service account with Wallet API enabled
GOOGLE_WALLET_ISSUER_ID=1234567890123456789
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

# Public URL for wallet pass links
PUBLIC_URL=https://loyali.online
