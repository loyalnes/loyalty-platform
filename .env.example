# Database connection URL
# The connection pool is configured in src/prisma.ts with:
# - min: 2 connections (always ready)
# - max: 10 connections (prevent exhaustion)
# - idleTimeoutMillis: 30000 (close idle connections after 30s)
# - connectionTimeoutMillis: 10000 (fail after 10s if no connection available)
DATABASE_URL="postgresql://user:password@localhost:5432/loyalty_platform?schema=public"

# Server port
PORT=3000

# CORS allowed origin
CORS_ORIGIN=https://yourdomain.com
